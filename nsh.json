{
  "name": "Native Editor",
  "id": "dev.byronwayne.nativeeditor",
  "version": "0.0.1",
  "build": 1,
  "icon": "assets/icon.png",
  "theme": {
    "cssVars": {
      "dark": {
        "background": "#161514",
        "foreground": "#ede8de",
        "card": "#232220",
        "card-foreground": "#ede8de",
        "popover": "#232220",
        "popover-foreground": "#ede8de",
        "primary": "#e8462b",
        "primary-foreground": "#f7f4ee",
        "secondary": "#2a2826",
        "secondary-foreground": "#ede8de",
        "muted": "#1d1c1a",
        "muted-foreground": "#8f897e",
        "accent": "#2e2c29",
        "accent-foreground": "#ede8de",
        "border": "#33312d",
        "input": "#33312d",
        "ring": "#e8462b",
        "sidebar": "#1d1c1a",
        "sidebar-foreground": "#8f897e",
        "sidebar-primary": "#e8462b",
        "sidebar-primary-foreground": "#f7f4ee",
        "sidebar-accent": "#2a2826",
        "sidebar-accent-foreground": "#ede8de",
        "sidebar-border": "#33312d"
      },
      "light": {
        "background": "#efebe3",
        "foreground": "#141414",
        "card": "#f7f4ee",
        "card-foreground": "#141414",
        "popover": "#f7f4ee",
        "popover-foreground": "#141414",
        "primary": "#d7381e",
        "primary-foreground": "#f7f4ee",
        "secondary": "#e5e0d5",
        "secondary-foreground": "#141414",
        "muted": "#e5e0d5",
        "muted-foreground": "#6d685f",
        "accent": "#ddd7cb",
        "accent-foreground": "#141414",
        "border": "#cfc8bb",
        "input": "#cfc8bb",
        "ring": "#d7381e",
        "sidebar": "#e5e0d5",
        "sidebar-foreground": "#6d685f",
        "sidebar-primary": "#d7381e",
        "sidebar-primary-foreground": "#f7f4ee",
        "sidebar-accent": "#ddd7cb",
        "sidebar-accent-foreground": "#141414",
        "sidebar-border": "#cfc8bb"
      }
    }
  },
  "capabilities": {
    "fs": {
      "read": [
        "${homeDir}",
        "/tmp",
        "/"
      ],
      "write": [
        "${homeDir}",
        "/tmp"
      ]
    },
    "process": {
      "execute": [
        "git",
        "python3",
        "sips",
        "osascript"
      ],
      "exit": true,
      "env": [
        "SHELL",
        "USER",
        "PATH",
        "HOME",
        "TERM",
        "TERM_PROGRAM",
        "GHOSTTY_RESOURCES_DIR",
        "LANG",
        "PWD",
        "NATIVE_EDITOR_ROOT",
        "NATIVE_EDITOR_OPEN_FILE"
      ]
    },
    "clipboard": true,
    "picker": true,
    "openUrl": true,
    "host": true,
    "webview": {
      "hosts": [
        "*"
      ]
    },
    "network": {
      "hosts": [
        "*"
      ]
    }
  }
}
